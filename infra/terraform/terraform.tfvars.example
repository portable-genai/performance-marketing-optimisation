# terraform.tfvars.example - copy to terraform.tfvars and fill in for your project.
# All values here are FICTIONAL placeholders.

# Required: the single-tenant, single-market project hosting performance-marketing-optimisation.
project_id = "mkt-perf-sg-fictional-0001"

# Residency region. SG market default; JP -> asia-northeast1, AU -> australia-southeast1.
region = "asia-southeast1"

# WORM audit retention (~7 years). The bucket lock is irreversible; keep >= 2557.
retention_days = 2557

# The WORM lock has NO default: a plan refuses until it is stated here. true is the compliant
# production form and is IRREVERSIBLE for the retention window; an evaluation stack that must
# stay destroyable states false (NOT compliant).
worm_locked = true

# Org-level inputs (needed for org-wide policy / VPC-SC). Leave blank for project-scoped use.
org_id           = "000000000000"
access_policy_id = ""

# VPC Service Controls. Stand the perimeter up in dry-run first, watch the audit logs,
# then set vpc_sc_dry_run = false to enforce.
enable_vpc_sc  = false
vpc_sc_dry_run = true

# Cloud Run image (Artifact Registry, asia-southeast1).
container_image = "asia-southeast1-docker.pkg.dev/mkt-perf-sg-fictional-0001/mkt/performance-marketing-optimisation:0.1.0"

# Monitoring notification channels (create separately; ids look like below).
alert_notification_channels = []
# alert_notification_channels = ["projects/mkt-perf-sg-fictional-0001/notificationChannels/0000000000000000000"]

# Cheap runtime controls stay on in the reference; say so rather than inheriting the default.
# With review routing on the service refuses to boot without the console it routes to.
guardrail_enabled      = true
review_routing_enabled = true
human_review_url       = "https://human-review.acme-bank.example"
